VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=demo-rv-trip-planner
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# Google Maps JS API key (HTTP-referrer restricted browser key)
VITE_GOOGLE_MAPS_API_KEY=

# Set to "true" to point the app at the local Firebase Emulator Suite
VITE_USE_FIREBASE_EMULATORS=false
