{
  "name": "functions",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "npm --prefix ../shared run build && tsc --noEmit && npm run bundle",
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=lib/index.js --sourcemap --external:firebase-admin --external:firebase-admin/* --external:firebase-functions --external:firebase-functions/* --external:@anthropic-ai/sdk --external:zod",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "vitest run",
    "debug:curate": "esbuild src/debug/curate.ts --bundle --platform=node --target=node20 --format=esm --outfile=lib/debug-curate.mjs --external:firebase-admin --external:firebase-admin/* --external:firebase-functions --external:firebase-functions/* --external:@anthropic-ai/sdk --external:zod && node lib/debug-curate.mjs",
    "debug:search": "esbuild src/debug/search.ts --bundle --platform=node --target=node20 --format=esm --outfile=lib/debug-search.mjs --external:firebase-admin --external:firebase-admin/* --external:firebase-functions --external:firebase-functions/* --external:@anthropic-ai/sdk --external:zod && node lib/debug-search.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^7.2.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
