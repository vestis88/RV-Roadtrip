# Real API keys for the debug tools (npm run debug:curate).
#
# Copy to .env.debug.local — which is gitignored — and fill in. The tools read
# the same two secrets the deployed functions do, so what you see locally is
# what production does, not an approximation of it.
#
# Both are already in Google Secret Manager for the deployed functions:
#   gcloud secrets versions access latest --secret=CLAUDE_API_KEY
#   gcloud secrets versions access latest --secret=GOOGLE_PLACES_API_KEY
#
# Without GOOGLE_PLACES_API_KEY every candidate reports as unlocated, which
# looks exactly like a verification failure — so set both or read the output
# knowing that column is meaningless.
CLAUDE_API_KEY=
GOOGLE_PLACES_API_KEY=
