rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isMember(tripId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid));
    }

    match /trips/{tripId} {
      // Trip creation and joining-by-code only happen via the createTrip
      // and joinTrip Cloud Functions (Admin SDK bypasses these rules).
      allow read, update: if isMember(tripId);
      allow create, delete: if false;

      match /members/{uid} {
        allow read: if isMember(tripId);
        allow write: if false;
      }

      match /days/{dayId} {
        allow read, write: if isMember(tripId);

        match /activities/{placeId} {
          allow read, write: if isMember(tripId);
        }

        match /restaurants/{placeId} {
          allow read, write: if isMember(tripId);
        }
      }

      match /corridorStops/{stopId} {
        allow read, write: if isMember(tripId);
      }

      match /log/{entryId} {
        allow read, write: if isMember(tripId);
      }
    }

    match /shareCodes/{code} {
      allow read, write: if false;
    }

    // Reverse index for "my trips" — normally written by createTrip/joinTrip/
    // deleteTrip via the Admin SDK (bypasses these rules), same pattern as
    // trips/{tripId}/members. Client-side self-write is allowed too, but
    // only for a trip the caller is already a genuine member of (isMember,
    // an Admin-SDK-controlled fact) and only their own uid's path — this
    // isn't a new capability, it's a backfill for trips created before this
    // reverse index existed (or any other write that landed membership
    // without it), which useTripSession.ts performs client-side the first
    // time it notices one missing.
    // Country research, deliberately outside every trip so one lookup serves
    // them all. The document ID encodes country + section + brief + (where
    // it matters) vehicle, so a reader can only ever find an entry that
    // answers exactly their question — see countryGuideSectionDocId. Writes
    // are the researchCountrySections callable's alone: it is the only thing
    // that has actually run the research, and letting a client write here
    // would let anyone poison what every other traveler reads.
    match /countryGuideSections/{sectionDocId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Per-traveler preferences, of which the country research brief is the
    // first — never shared, unlike the research it produces.
    match /users/{uid}/preferences/{prefId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/trips/{tripId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid && isMember(tripId);
    }

    match /planRequests/{requestId} {
      // A planRequests doc is what triggers generatePlan.ts's expensive
      // Claude/Places/Routes pipeline — without isMember here, any signed-in
      // user could fire a full generation against a trip they don't belong
      // to just by knowing its tripId, burning that trip's owner's API
      // quota and overwriting their days. Matches every other subcollection
      // in this ruleset, which all gate on isMember(tripId).
      allow create: if isMember(request.resource.data.tripId);
      allow read: if isMember(resource.data.tripId);
      allow update, delete: if false;
    }
  }
}
