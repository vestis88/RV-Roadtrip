rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isMember(tripId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid));
    }

    // "May this signed-in user use the app at all", as opposed to
    // isMember()'s "may they touch THIS trip". The `access` custom claim is
    // handed out only by the claimAccess callable, only to a verified email
    // on config/allowlist — so it is what separates the owner's two trusted
    // accounts from any other visitor who happened to sign in. Every rule
    // below requires BOTH: this is an extra gate in front of the existing
    // per-trip checks, never a replacement for them.
    //
    // Read through get() with a default: most signed-in users have no custom
    // claims at all, and a bare `request.auth.token.access` on a token that
    // lacks the key is an evaluation error rather than a plain false.
    function hasAccess() {
      return request.auth != null && request.auth.token.get('access', false) == true;
    }

    match /trips/{tripId} {
      // Trip creation and joining-by-code only happen via the createTrip
      // and joinTrip Cloud Functions (Admin SDK bypasses these rules).
      allow read, update: if hasAccess() && isMember(tripId);
      allow create, delete: if false;

      match /members/{uid} {
        allow read: if hasAccess() && isMember(tripId);
        allow write: if false;
      }

      match /days/{dayId} {
        allow read, write: if hasAccess() && isMember(tripId);

        match /activities/{placeId} {
          allow read, write: if hasAccess() && isMember(tripId);
        }

        match /restaurants/{placeId} {
          allow read, write: if hasAccess() && isMember(tripId);
        }

        match /overnightOptions/{optionId} {
          allow read, write: if hasAccess() && isMember(tripId);
        }
      }

      match /corridorStops/{stopId} {
        allow read, write: if hasAccess() && isMember(tripId);
      }

      match /log/{entryId} {
        allow read, write: if hasAccess() && isMember(tripId);
      }

      // The map's last search, kept so it survives the app closing — see
      // searchScratchSchema. Written by the callable and cleared by the
      // client as finds are added, so members need both.
      match /scratch/{docId} {
        allow read, write: if hasAccess() && isMember(tripId);
      }
    }

    match /shareCodes/{code} {
      allow read, write: if false;
    }

    // Family view links (createTripShareLink / viewSharedTrip). Server-only
    // for the same reason shareCodes is, plus one of its own: a client read
    // here would turn "knows a tripId" into "can mint or find that trip's
    // public view link", and a client write would let anyone point an
    // existing token at a trip that isn't theirs. The viewSharedTrip
    // endpoint resolves tokens through the Admin SDK, which bypasses these
    // rules — nothing else ever needs to touch this collection.
    match /shareTokens/{token} {
      allow read, write: if false;
    }

    // The access allowlist itself. Owner-maintained from the Firebase
    // console (the Admin SDK ignores these rules); denied to every client
    // both ways, because reading it would expose the trusted addresses and
    // writing it would let a caller add themselves and then claimAccess.
    match /config/{document=**} {
      allow read, write: if false;
    }

    // Reverse index for "my trips" — normally written by createTrip/joinTrip/
    // deleteTrip via the Admin SDK (bypasses these rules), same pattern as
    // trips/{tripId}/members. Client-side self-write is allowed too, but
    // only for a trip the caller is already a genuine member of (isMember,
    // an Admin-SDK-controlled fact) and only their own uid's path — this
    // isn't a new capability, it's a backfill for trips created before this
    // reverse index existed (or any other write that landed membership
    // without it), which useTripSession.ts performs client-side the first
    // time it notices one missing.
    // Country research, deliberately outside every trip so one lookup serves
    // them all. The document ID encodes country + section + brief + (where
    // it matters) vehicle, so a reader can only ever find an entry that
    // answers exactly their question — see countryGuideSectionDocId. Writes
    // are the researchCountrySections callable's alone: it is the only thing
    // that has actually run the research, and letting a client write here
    // would let anyone poison what every other traveler reads.
    match /countryGuideSections/{sectionDocId} {
      allow read: if hasAccess();
      allow write: if false;
    }

    // Per-traveler preferences, of which the country research brief is the
    // first — never shared, unlike the research it produces.
    match /users/{uid}/preferences/{prefId} {
      allow read, write: if hasAccess() && request.auth.uid == uid;
    }

    match /users/{uid}/trips/{tripId} {
      allow read: if hasAccess() && request.auth.uid == uid;
      allow write: if hasAccess() && request.auth.uid == uid && isMember(tripId);
    }

    match /planRequests/{requestId} {
      // A planRequests doc is what triggers generatePlan.ts's expensive
      // Claude/Places/Routes pipeline — without isMember here, any signed-in
      // user could fire a full generation against a trip they don't belong
      // to just by knowing its tripId, burning that trip's owner's API
      // quota and overwriting their days. Matches every other subcollection
      // in this ruleset, which all gate on isMember(tripId).
      allow create: if hasAccess() && isMember(request.resource.data.tripId);
      allow read: if hasAccess() && isMember(resource.data.tripId);
      allow update, delete: if false;
    }
  }
}
