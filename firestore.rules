rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isMember(tripId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid));
    }

    match /trips/{tripId} {
      // Trip creation and joining-by-code only happen via the createTrip
      // and joinTrip Cloud Functions (Admin SDK bypasses these rules).
      allow read, update: if isMember(tripId);
      allow create, delete: if false;

      match /members/{uid} {
        allow read: if isMember(tripId);
        allow write: if false;
      }

      match /days/{dayId} {
        allow read, write: if isMember(tripId);

        match /activities/{placeId} {
          allow read, write: if isMember(tripId);
        }

        match /restaurants/{placeId} {
          allow read, write: if isMember(tripId);
        }
      }

      match /countries/{countryCode} {
        allow read, write: if isMember(tripId);
      }

      match /corridorStops/{stopId} {
        allow read, write: if isMember(tripId);
      }

      match /log/{entryId} {
        allow read, write: if isMember(tripId);
      }
    }

    match /shareCodes/{code} {
      allow read, write: if false;
    }

    // Reverse index for "my trips" — written by createTrip/joinTrip via the
    // Admin SDK (bypasses these rules), same pattern as trips/{tripId}/members.
    match /users/{uid}/trips/{tripId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /planRequests/{requestId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
